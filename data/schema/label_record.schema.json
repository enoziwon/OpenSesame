{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LabelRecord",
  "description": "한국 포장식품 라벨 한 건의 전사와 정답 (미국 의무 표시 알레르겐 9개 기준)",
  "type": "object",
  "required": ["id", "product_type", "package_material", "ingredients_text", "kr_declared_allergens", "annotations"],
  "properties": {
    "id": { "type": "string", "description": "이름_제품번호 (예: jy_07)" },
    "annotator": { "type": "string" },
    "product_type": {
      "enum": ["snack", "sauce_seasoning", "instant", "frozen", "beverage_dairy", "other"]
    },
    "package_material": { "enum": ["foil", "plastic_film", "paper", "can_bottle", "other"] },
    "report_number": { "type": ["string", "null"], "description": "품목보고번호 (API 조인 키)" },
    "image_files": { "type": "array", "items": { "type": "string" } },
    "ingredients_text": { "type": "string", "description": "원재료명 전문을 보이는 그대로 (오타·줄바꿈 포함)" },
    "kr_declared_allergens": {
      "type": "array",
      "description": "한국 표시란에 적힌 항목 그대로 (참고 정보. 판정 기준이 아님)",
      "items": { "type": "string" }
    },
    "annotations": {
      "type": "array",
      "description": "미국 9개 알레르겐 판정. 목록에 없는 알레르겐은 '해당 없음'으로 본다. 판단이 불가능하면 undecidable로 적는다",
      "items": {
        "type": "object",
        "required": ["allergen", "verdict", "evidence_ingredient", "legal_basis"],
        "properties": {
          "allergen": {
            "enum": ["milk", "egg", "fish", "crustacean", "tree_nut", "peanut", "wheat", "soy", "sesame"],
            "description": "미국 의무 표시 알레르겐 9개"
          },
          "verdict": { "enum": ["confirmed", "inferable", "undecidable"] },
          "evidence_ingredient": { "type": "string", "description": "근거가 된 원재료 표기 그대로" },
          "hidden_or_derived": {
            "type": "boolean",
            "description": "복합 원재료·추출물·유래 표현 속에 든 경우 true (통과 조건 ① 집계용)"
          },
          "declared_in_kr": {
            "type": "boolean",
            "description": "한국 표시란에 이미 표시되었는지 (참고 정보)"
          },
          "legal_basis": { "type": "string", "description": "근거 조항 또는 지침" },
          "exception_note": { "type": ["string", "null"] },
          "annotator_agreement": { "type": ["string", "null"], "description": "교차 검수 결과 메모" }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
