# 복사해서 .env로 사용 (.env는 커밋 금지)
DATA_GO_KR_API_KEY=여기에_공공데이터포털_인증키
# OCR: CLOVA OCR (네이버 클라우드) General 도메인. 키는 김민재에게 개인 메시지로 받기
CLOVA_SECRET=
CLOVA_URL=

# LLM: 숭실대 BAZE 게이트웨이 (OpenAI 호환). 키는 각자 발급
LLM_PROVIDER=openai
LLM_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
LLM_API_KEY=
LLM_MODEL=게이트웨이_모델탭의_이름
LLM_USE_TOOLS=1
LLM_TOOL_CHOICE=auto
LLM_TEMPERATURE=0

# 서버는 두 개다 (결정 0004)
#   제품(최종본): uvicorn src.final.app:app --port 8001   ← 평소 개발·시연·프론트 연결
#   1차 비교용  : uvicorn src.app.main:app --port 8000    ← 평가할 때만 (LLM 크레딧 사용)
# OCR: mock = 가짜(개발용) / clova = 실제 OCR (월 100건 한도, 필요할 때만)
# 1차 분류기: mock = 가짜(개발용) / llm = LLM 분류기
# 최종본: OPENSESAME_FINAL_FALLBACK=llm 이면 사전·규칙이 모르는 이름만 LLM에 묻는다 (기본 끔)
OPENSESAME_OCR=clova
OPENSESAME_CLASSIFIER=llm
OPENSESAME_FINAL_FALLBACK=
CORS_ORIGINS=*
