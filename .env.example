# 복사해서 .env로 사용 (.env는 커밋 금지)
DATA_GO_KR_API_KEY=여기에_공공데이터포털_인증키
OCR_API_KEY=

# LLM: 숭실대 BAZE 게이트웨이 (OpenAI 호환). 키는 각자 발급
LLM_PROVIDER=openai
LLM_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
LLM_API_KEY=
LLM_MODEL=게이트웨이_모델탭의_이름
LLM_USE_TOOLS=1
LLM_TOOL_CHOICE=auto
LLM_TEMPERATURE=0

# mock = 가짜(개발용) / llm = LLM 분류기
OPENSESAME_OCR=mock
OPENSESAME_CLASSIFIER=mock
CORS_ORIGINS=*
