# 복사해서 .env로 사용 (.env는 커밋 금지)
DATA_GO_KR_API_KEY=여기에_공공데이터포털_인증키
# OCR: CLOVA OCR (네이버 클라우드) General 도메인. 키는 김민재에게 개인 메시지로 받기
CLOVA_SECRET=
CLOVA_URL=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# OCR: mock = 가짜(개발용) / clova = 실제 OCR
# 분류기: mock = 가짜(개발용) / llm = LLM 분류기
OPENSESAME_OCR=mock
OPENSESAME_CLASSIFIER=mock
CORS_ORIGINS=*
